{
	"schemaVersion": 1,
	"id": "mcbot",
	"version": "${version}",
	"name": "McBot",
	"description": "Lets an external program (Python) drive the player through a local TCP socket, and sends back images of the game.",
	"authors": [
		"Florian Desmons"
	],
	"license": "MIT",
	"icon": "assets/mcbot/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.mcbot.McBotClient"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	}
}
